<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="frontier_obstacle_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::Sensors" filename="ignition-gazebo-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.76 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>36 24</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>36 24</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.68 0.70 0.68 1</ambient>
            <diffuse>0.68 0.70 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer reference walls, far enough not to close the useful passages even with safety inflation. -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 8.0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>26 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>26 0.2 2</size></box></geometry>
          <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.62 0.64 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -8.0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>26 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>26 0.2 2</size></box></geometry>
          <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.62 0.64 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-13 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 0.2 2</size></box></geometry>
          <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.62 0.64 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>13 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 0.2 2</size></box></geometry>
          <material><ambient>0.62 0.64 0.66 1</ambient><diffuse>0.62 0.64 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main occluder: from the start, the goal behind it should remain unknown. -->
    <model name="central_block">
      <static>true</static>
      <pose>4.0 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 2.0 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 2.0 2.0</size></box></geometry>
          <material><ambient>0.46 0.38 0.30 1</ambient><diffuse>0.46 0.38 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small side obstacles make the map realistic but leave wide passages. -->
    <model name="side_box_north">
      <static>true</static>
      <pose>8.0 5.0 0.7 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 1.4</size></box></geometry>
          <material><ambient>0.35 0.45 0.50 1</ambient><diffuse>0.35 0.45 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="side_box_south">
      <static>true</static>
      <pose>8.0 -5.0 0.7 0 0 -0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 1.4</size></box></geometry>
          <material><ambient>0.35 0.45 0.50 1</ambient><diffuse>0.35 0.45 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
  </world>
</sdf>
